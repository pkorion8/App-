# Copy to .env.local (apps/web reads it via Next.js's built-in env loading).
#
# Local dev: run `supabase start` (Supabase CLI) and use the printed
# "API URL" / "anon key" values, or the defaults below for the standard
# local ports (see supabase/config.toml).
#
# Hosted: use your Supabase project's Settings > API values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used for authentication magic-link redirects.
# In production, set this to the canonical HTTPS origin with no path,
# for example: https://app.example.com
# Preview deployments can omit this and fall back to trusted forwarded-host headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Creator-intelligence cron integration (optional for the core Sim Venture flow).
# Vercel automatically sends `Authorization: Bearer <CRON_SECRET>` to cron routes
# when CRON_SECRET is configured in the project. Generate a strong random value.
CRON_SECRET=

# Server-side only. Never expose this key through a NEXT_PUBLIC_* variable.
# Required only by the creator-intelligence cron because it writes source records.
SUPABASE_SERVICE_ROLE_KEY=

# Required only by the creator-intelligence cron's YouTube discovery step.
YOUTUBE_API_KEY=

# Optional local override for transcript extraction. Vercel uses the bundled
# @sparticuz/chromium executable when this is left unset.
CHROMIUM_EXECUTABLE_PATH=

# Billing (optional -- the app runs fine without these, Billing just shows
# an "isn't configured yet" notice instead of an upgrade button).
# Stripe dashboard > Developers > API keys (test mode is free, no card
# needed to build/test against). Create one recurring Product/Price for
# the Pro plan and use its Price ID below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
# Stripe dashboard > Developers > Webhooks > add endpoint pointing at
# <your-deployed-url>/api/webhooks/stripe, then copy its signing secret.
STRIPE_WEBHOOK_SECRET=
