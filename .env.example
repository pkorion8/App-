# Copy to .env.local (apps/web reads it via Next.js's built-in env loading).
#
# Local dev: run `supabase start` (Supabase CLI) and use the printed
# "API URL" / "anon key" values, or the defaults below for the standard
# local ports (see supabase/config.toml).
#
# Hosted: use your Supabase project's Settings > API values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Billing (optional -- the app runs fine without these, Billing just shows
# an "isn't configured yet" notice instead of an upgrade button).
# Stripe dashboard > Developers > API keys (test mode is free, no card
# needed to build/test against). Create one recurring Product/Price for
# the Pro plan and use its Price ID below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
# Stripe dashboard > Developers > Webhooks > add endpoint pointing at
# <your-deployed-url>/api/webhooks/stripe, then copy its signing secret.
STRIPE_WEBHOOK_SECRET=
