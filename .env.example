# Copy to .env.local (apps/web reads it via Next.js's built-in env loading).
#
# Local dev: run `supabase start` (Supabase CLI) and use the printed
# "API URL" / "anon key" values, or the defaults below for the standard
# local ports (see supabase/config.toml).
#
# Hosted: use your Supabase project's Settings > API values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
